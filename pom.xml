<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.Liuling</groupId>
    <artifactId>tinyquery</artifactId>
    <version>1.1.0</version>
    <packaging>jar</packaging>

    <name>LynMill</name>
    <description>本地零运维的多数据源 SQL 查询引擎：把 CSV / Excel、MySQL、PostgreSQL、SQLite 加载进列式存储，直接用 SQL 查询</description>

    <!-- 作者是个人的学习项目，不是公司产品。 -->
    <url>https://github.com/Liuling-GT/lynmill</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>Liuling</id>
            <name>Liuling</name>
            <roles>
                <role>author</role>
                <role>maintainer</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Liuling-GT/lynmill.git</connection>
        <developerConnection>scm:git:https://github.com/Liuling-GT/lynmill.git</developerConnection>
        <url>https://github.com/Liuling-GT/lynmill</url>
        <tag>v1.1.0</tag>
    </scm>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 前端 dist 新鲜度检查的逃生口。默认 false = 检查生效；
             确实要用旧 dist 时用 -Dskip.frontend.freshness=true 临时跳过 -->
        <skip.frontend.freshness>false</skip.frontend.freshness>

        <!-- 构建信息，写进 build-info.properties 供运行时读取。
             build.time 在这里定死：properties 只求值一次，整个构建过程
             （编译、测试、打包）看到的是同一个时间，不会出现"编译时间"与
             "打包时间"不一致。
             文件本身由 antrun 的 generate-build-info 生成（含 git 短哈希），
             见那个 execution 的说明 -->
        <build.time>${maven.build.timestamp}</build.time>
        <!-- maven.build.timestamp 的格式。用本地时间的可读形式，
             而不是 ISO8601 的 UTC（用户看到的时间要和自己手表对得上） -->
        <maven.build.timestamp.format>yyyy-MM-dd HH:mm</maven.build.timestamp.format>
    </properties>

    <!-- 阿里云镜像仓库（加速下载） -->
    <repositories>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>aliyun-plugin</id>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <dependencies>

        <!-- 测试：包含 JUnit 5 + AssertJ + Mockito + MockMvc，
             比裸的 junit-jupiter 更完整，且版本由 parent 统一管理 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>3.2.0</version>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
        </dependency>

        <!-- MariaDB 驱动。与 MySQL 驱动并存：
     两者协议兼容但不完全等同，各自用官方驱动更稳妥，
     尤其 MySQL 8 的 caching_sha2_password 认证插件 -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.3.3</version>
        </dependency>

        <!-- PostgreSQL 驱动 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>

        <!-- SQLite 驱动。注意这是 JNI 驱动，jar 内含多平台原生库，约 10MB -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.1.0</version>
        </dependency>

        <!-- JNA：用来调用操作系统原生的凭据管理接口（Windows CredWrite/CredRead/CredDelete，
             macOS 钥匙串，Linux Secret Service）。选择它的理由：
             ① 双许可 LGPL-2.1-or-later 或 Apache-2.0，**由使用方任选**，我们按 Apache-2.0 使用，
                与 MySQL Connector/J 的 GPLv2+FOSS 例外、MariaDB 的 LGPL 是两回事；
             ② 仍在维护（5.19.1 / 2026-06-12 发布），不是弃坑项目；
             ③ jar 约 1.9MB，自身没有任何传递依赖 —— 对比 java-keyring 会拖进 25 个 jar（含 LGPL 的 dbus-java）；
             ④ jar 内已含各平台原生库，用户不需要另装任何东西。
             刻意**不引 jna-platform**（约 1.4MB）：那是 Win32 全套 API 的封装，我们只用 3 个函数，
             自己声明接口即可，见 com.tinyquery.credential.WindowsCredentialStore。 -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.19.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
        <!--============================================================
            构建产物防呆：前端 dist 必须存在、且不比前端源码旧。

            为什么必须有这一步（都是一路踩过来的）：
              ① dist 缺失时 copy-resources 会「静默跳过」，打出一个没有前端的 jar。
                 启动后访问 / 是 404，看起来像后端坏了。
              ② 比缺失更危险的是「过期」：9/28 构建的 dist 里不含任何 token 代码，
                 若直接打包，jar 里的前端调 API 会全部 401 ——
                 界面看起来是坏的，却没有任何地方解释为什么。
                 缺失至少明显，过期是静默的。
              ③ 本次重新打包时又踩了一次：mvn 因目录不对而失败，
                 但脚本继续用旧 jar 做完了 jpackage，退出码 0、大小正常，
                 只有比对哈希才发现前端是旧的。退出码 0 不代表内容是新的。

            enforcer 插件只能查「文件存在」，查不了「新鲜度」，
            所以用 antrun 跑一小段判断。放在 validate 阶段 ——
            越早失败越好，不必等编译完才发现前端是旧的。

            跳过方式（确实要用旧 dist 时）：mvn package -Dskip.frontend.freshness=true
            ============================================================-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>check-frontend-dist-freshness</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <!-- 逃生口：确实需要用旧 dist 时，加 -Dskip.frontend.freshness=true -->
                            <skip>${skip.frontend.freshness}</skip>
                            <!-- 注意：这里刻意不用 <script language="javascript">。
                                 JDK 15 起移除了 Nashorn，Ant 的 JS 脚本引擎在 JDK 17 上
                                 直接报 "Unable to create javax script engine for javascript"。
                                 用 Ant 原生的 <uptodate> 做时间比较，不依赖任何脚本引擎。 -->
                            <target>
                                <!-- 前置 ①：dist 必须存在 -->
                                <fail message="【构建防呆】前端未构建：tinyquery-frontend/dist/index.html 不存在。请先执行：cd tinyquery-frontend &amp;&amp; npm run build。若确实要用已有 dist，加 -Dskip.frontend.freshness=true">
                                    <condition>
                                        <not>
                                            <available file="${project.basedir}/tinyquery-frontend/dist/index.html"/>
                                        </not>
                                    </condition>
                                </fail>

                                <!-- 前置 ②：dist 不能比 src 旧。
                                     uptodate 的语义：targetfile 比所有 srcfiles 新时，
                                     把 property 设为 true。
                                     我们反过来用：若不成立（即 src 更新），就判定过期。 -->
                                <uptodate property="frontend.dist.isFresh"
                                          targetfile="${project.basedir}/tinyquery-frontend/dist/index.html">
                                    <srcfiles dir="${project.basedir}/tinyquery-frontend/src"/>
                                    <srcfiles dir="${project.basedir}/tinyquery-frontend"
                                              includes="index.html,vite.config.js,package.json"/>
                                </uptodate>

                                <fail message="【构建防呆】前端 dist 已过期：tinyquery-frontend/src 下有文件比 dist/index.html 更新。请重新执行：cd tinyquery-frontend &amp;&amp; npm run build。若确实要用旧 dist，加 -Dskip.frontend.freshness=true">
                                    <condition>
                                        <not>
                                            <isset property="frontend.dist.isFresh"/>
                                        </not>
                                    </condition>
                                </fail>

                                <echo message="【构建防呆】前端 dist 新鲜度检查通过"/>
                            </target>
                        </configuration>
                    </execution>

                    <!-- 生成 build-info.properties：版本 + 构建时间 + git 短哈希。
                         
                         【为什么整份文件都由 Ant 写，而不是让 Maven 过滤占位符】
                         试过 resources 过滤，两处都卡住，最后放弃：
                           ① Maven 已定义的属性会压过 Ant 的 <condition>，
                              在 <properties> 里声明 build.commit 为空之后就永远填不上；
                           ② 不声明的话，Ant 设的 git.commit.resolved 是【Ant 属性】，
                              Maven 的 resources 过滤看不见它，会原样打进产物。
                         转手到文件再读回来能work，但要额外一个 .properties 资源 + 
                         额外一个阶段，链条长得不好维护。
                         直接由 Ant 生成整份文件最简单：一次写清三个值，
                         不经过任何过滤，链路只有一步。
                         
                         【取不到 git 怎么办】写空串。代码里识别为"未知"并省略这一段，
                         界面上不会出现占位符。没装 git、不是仓库、尚未提交
                         都属于这种情况，都不该让构建失败。
                         
                         放在 generate-resources：早于 process-resources
                         （resources 插件会把这里生成的文件复制到 target/classes） -->
                    <execution>
                        <id>generate-build-info</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="git" dir="${project.basedir}"
                                      outputproperty="git.commit.raw"
                                      errorproperty="git.commit.err"
                                      failonerror="false">
                                    <arg value="rev-parse"/>
                                    <arg value="--short"/>
                                    <arg value="HEAD"/>
                                </exec>
                                <condition property="git.commit.resolved" value="${git.commit.raw}">
                                    <and>
                                        <isset property="git.commit.raw"/>
                                        <not>
                                            <equals arg1="${git.commit.raw}" arg2=""/>
                                        </not>
                                    </and>
                                </condition>
                                <!-- 取不到就用空串，不写任何占位符 —— 代码里会当"未知" -->
                                <property name="git.commit.resolved" value=""/>

                                <mkdir dir="${project.build.outputDirectory}"/>
                                <echo file="${project.build.outputDirectory}/build-info.properties"
                                      message="build.version=${project.version}${line.separator}build.time=${build.time}${line.separator}build.commit=${git.commit.resolved}${line.separator}"/>
                                <echo message="构建标识：${project.version} · commit=${git.commit.resolved} · time=${build.time}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        <!--把前端构建产物复制进 jar 的 static/ 目录。
            必须在 prepare-package 阶段、且在 spring-boot-maven-plugin 之前 ——
            repackage 一旦执行，jar 结构就定了，之后再复制进去也没用。
            Spring Boot 会自动把 classpath:/static/ 下的 index.html
            作为欢迎页返回，所以访问 / 就能看到前端，不需要额外配置-->
        <!-- 测试运行时的环境隔离。
             必须把 LYNMILL_HOME 指到 target 下：普通测试里没人在意，
             但语言落盘（DesktopLocale.switchTo）与数据源持久化都会调
             PathResolver.getDataDir()，不给它一个隔离目录就会写进开发者
             真实的 %APPDATA%\LynMill —— 跑一次测试就把人家的语言和数据源改了 -->
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
                <environmentVariables>
                    <LYNMILL_HOME>${project.build.directory}/test-home</LYNMILL_HOME>
                </environmentVariables>
                <!-- 环境变量 LYNMILL_LOCALE 优先级高于 locale.txt。
                     如果开发者本机恰好设过它，语言相关的测试会跟着变 —— 显式清掉 -->
                <argLine>-Dfile.encoding=UTF-8</argLine>
            </configuration>
        </plugin>

        <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>tinyquery-frontend/dist</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        <!-- 复制前端产物之前，先清掉上一次留下的文件。
            必须清 —— Vite 的产物名带内容哈希（index-CGfHrKqe.js），
            文件名一变旧的就不会被覆盖，于是 target/classes/static/assets 会
            一次次累积历史包：实测堆过 2 个 js + 2 个 css，而只有一个是对的。
            两个后果：① 每个发布包都白白变大；
            ② 谁要是加载到旧文件，就会拿到上一版的前端而毫无察觉
            （对照实验里就踩中过：改了源码重新打包，浏览器却仍加载旧的）。

            刻意不给插件加 configuration 里的 excludeDefaultDirectories：
            那会让 `mvn clean` 连整个 target 都不删了（实测过，target 会残留）。
            这里只用 executions 里的一次 fileset，默认的 clean 行为不受影响 -->
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <executions>
                <execution>
                    <id>clean-stale-frontend</id>
                    <!-- 用 process-classes 而不是 prepare-package。
                         两个插件同处一个阶段时，顺序只由 pom 里的声明先后决定 ——
                         那是隐式的、改个位置就会静默失效。放到更早的阶段，
                         「先清后复制」就是阶段本身保证的，与声明顺序无关。
                         顺序反了的后果实测过：clean 把刚复制进去的产物一起删掉，
                         jar 里一个前端文件都没有 -->
                    <phase>process-classes</phase>
                    <goals>
                        <goal>clean</goal>
                    </goals>
                    <configuration>
                        <excludeDefaultDirectories>true</excludeDefaultDirectories>
                        <filesets>
                            <fileset>
                                <directory>${project.build.outputDirectory}/static</directory>
                                <includes>
                                    <include>**/*</include>
                                </includes>
                            </fileset>
                        </filesets>
                    </configuration>
                </execution>
            </executions>
        </plugin>

            <!-- Spring Boot 可执行 jar 打包插件。
                 它会产出 BOOT-INF 结构的 fat jar，并自动合并各依赖中的
                 AutoConfiguration.imports / spring.factories / META-INF/services。
                 不要改用 maven-shade-plugin：shade 遇重名资源默认丢弃而非合并，
                 会导致部分自动配置随机失效 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- 版本由 spring-boot-starter-parent 统一管理，无需声明 -->
                <configuration>
                    <mainClass>com.tinyquery.TinyQueryApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>