target/
*.class
*.log

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# 测试数据（体积大且可由 DataGenerator / DataGenerator2 重新生成）
data/*.csv

# 保留手写的 sample.csv
!data/sample.csv

# 本地测试用的数据库文件，可随时重建
data/*.db
data/*.sqlite
data/*.sqlite3

# 前端依赖与产物
tinyquery-frontend/node_modules/
tinyquery-frontend/dist/

# jpackage 打包产物：约 94 MB（其中 47 MB 是自带的运行时），
# 体积大且可随时用 jpackage 重新生成，不该进版本库
jpackage-out/

# jlink 生成的精简运行时（packaging/make-runtime.py 的中间产物）：
# 约 47 MB，每次打包都会重新生成，同样不该进版本库
tinyquery-runtime/

# Python 字节码缓存（packaging/*.py 跑过就会产生）
__pycache__/
